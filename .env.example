# NETPATH environment template.
#
# Copy to .env (backend reads these from the process environment) and fill in real values.
# .env is gitignored and must never be committed. This file contains placeholders only.
#
# Nothing here is required for the H2 demo profile:
#   mvn spring-boot:run -Dspring-boot.run.profiles=dev

# --- PostgreSQL (source of truth) --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netpath
DB_USERNAME=netpath
DB_PASSWORD=change-me

# --- Redis (hot-state cache; optional, the API degrades to PostgreSQL without it) ---------------
REDIS_HOST=localhost
REDIS_PORT=6379
# If your Redis requires auth, set it via Spring's own property, which is what the client reads:
# SPRING_DATA_REDIS_PASSWORD=

# --- Security -----------------------------------------------------------------------------------
# No default exists: the application refuses to start without a value. Use at least 32 random
# characters (HMAC-SHA256 needs a 256-bit key).
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=86400000

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- HTTP ---------------------------------------------------------------------------------------
# SERVER_PORT wins when set; otherwise the PORT some hosts inject is used, then 8080.
SERVER_PORT=8080

# --- First operator on an empty database --------------------------------------------------------
# Enable for the first boot against an empty database, then set the flag back to false. This creates
# one admin account and nothing else. It is not the demo estate: see DEMO_DATA_ENABLED below.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=NETPATH Operator

# --- Development fixtures -----------------------------------------------------------------------
# Seeds a fabricated estate (applications, endpoints, paths, telemetry). Never enable in production.
DEMO_DATA_ENABLED=false
DEMO_DATA_EMAIL=operator@netpath.io
DEMO_DATA_PASSWORD=netpath123

# --- Frontend (Vite, read at build time) --------------------------------------------------------
# Must include the /api segment. Leave unset for local development, where the Vite dev server
# proxies /api to http://localhost:8080.
# VITE_API_BASE_URL=https://netpath-api.onrender.com/api
